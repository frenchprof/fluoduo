rules_version = '2';
// Reconciled rules for the unified laf1201 project (hub · pretest · reviser · FluoLingo).
// House style: owner-only writes, admin email allowlist, leaderboard exclusion list.
// Deploy: Firebase console → Firestore → Rules, or `firebase deploy --only firestore:rules`.
//
//   users/{uid}                      profile + reviser XP/progress   (owner read/write, admin read)
//   users/{uid}/attempts/{id}        APPEND-ONLY audit log            (owner create, never edited)
//   users/{uid}/responses/{id}       APPEND-ONLY item-level analytics (owner create, shape-checked)
//   users/{uid}/sessions/{id}        session telemetry                (owner create/update, monotonic)
//   users/{uid}/{sub=**}             pretest state/skills/runs, srs, notes, reviser sessions
//   leaderboard/{uid}                unified combined-total board     (owner write, VALUE-CHECKED, signed-in read)
//   events / authEvents              telemetry                        (signed-in create; events shape-checked)
//   feedback                         bug reports                      (ANONYMOUS create, shape-checked, admin read)
//   collections/{id}                 user-created decks               (owner write, public/unlisted read)
//   oralST2_2026/{uid}               ST2 oral-test bookings           (owner+admin write, shape-checked, signed-in read)
//   oralST2_2026_invites/{email}     teammate invites by email        (leader create, leader/invitee/admin delete)
//   mail/{id}                        Trigger Email extension outbox   (signed-in create, shape-checked)
//   siteVisits/{site}_{uid}          cross-site Google-login attendance (owner create/update, admin read/delete)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // email_verified guard: Google sign-in always verifies, but if another
    // auth provider is ever enabled, an attacker could otherwise mint an
    // UNVERIFIED token bearing an admin email and pass the allowlist.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in [
        "drneilchan@gmail.com", "monsieur.chan@gmail.com", "dan@chank.wang",
        "kaygeedan@gmail.com", "daniel.chan@nus.edu.sg", "kwangguan@gmail.com"
      ];
    }
    function isExcludedFromLeaderboard() {
      return isSignedIn() && request.auth.token.email in [
        "wanghaoshu2016@gmail.com", "theneonwolf0404@gmail.com", "clariseloke13@gmail.com",
        "nusally2023@gmail.com", "adrihashim@gmail.com", "enileg864@gmail.com",
        "mielanjames@gmail.com", "chee.advanced@gmail.com", "lohkelsey@gmail.com",
        "adamelistewart@gmail.com", "danielbordeaux89@gmail.com", "e1088156@u.nus.edu",
        "2964836865@qq.com", "wyanfong@gmail.com", "tcyy.10204@gmail.com",
        "azhari619@gmail.com", "clariceteoworking@gmail.com"
      ];
    }
    function validLeaderboardRow() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 10000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000
        && request.resource.data.gems is int
        && request.resource.data.gems >= 0
        && request.resource.data.gems <= 1000000
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 100000;
    }
    function validSession() {
      return request.resource.data.keys().hasOnly(
          ['xp', 'level', 'streak', 'lastStreakDate', 'itemPointer',
           'startedAt', 'updatedAt', 'durationMs', 'activityId'])
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 10000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 100000
        && (!('durationMs' in request.resource.data)
            || (request.resource.data.durationMs is int
                && request.resource.data.durationMs >= 0
                && request.resource.data.durationMs <= 86400000))
        && (!('activityId' in request.resource.data)
            || (request.resource.data.activityId is string
                && request.resource.data.activityId.size() <= 60));
    }
    function validDeck() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 500
        && (!('visibility' in request.resource.data)
            || request.resource.data.visibility in ['public', 'unlisted', 'private']);
    }
    match /users/{uid} {
      // Owner + admin only. The old "signed-in read" existed for a leaderboard
      // that now lives in its own collection; leaving it open let any student
      // enumerate every other student's profile. If a LEGACY site (hub /
      // pretest / reviser) still lists /users cross-user, it will start
      // getting permission-denied — loosen back deliberately if that happens.
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
      // Append-only audit log: attempt records can be created and read, never
      // edited or deleted — a trustworthy history even against the owner.
      match /attempts/{attemptId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
      // Item-level learning analytics, APPEND-ONLY and shape-checked. Field
      // names align with the SRS store (srs.ts): intervalDays + due, so the
      // response log and the scheduler speak the same language. latencyMs and
      // givenAnswer are optional analytics fields (fluency curves / error
      // taxonomy) — validated when present so they can ship later without a
      // rules redeploy.
      match /responses/{responseId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
              ['item', 'attempts', 'status', 'xp', 'timestamp', 'sessionId', 'activityId',
               'latencyMs', 'givenAnswer', 'intervalDays', 'due',
               // Evidence model (2026-08-10). All optional, so existing writers
               // keep working unchanged. PRD §7: a correct answer is not one
               // fact — it matters HOW it was produced.
               'outcomeId', 'evidenceType', 'assistance', 'assistCount', 'independent'])
          && request.resource.data.item is string
          && request.resource.data.item.size() >= 1
          && request.resource.data.item.size() <= 200
          && request.resource.data.attempts is list
          && request.resource.data.attempts.size() >= 1
          && request.resource.data.attempts.size() <= 20
          && request.resource.data.status in ['met', 'missed', 'retried', 'mastered']
          && request.resource.data.xp is int
          && request.resource.data.xp >= 0
          // WAS 100 (fixed 2026-08-10). progress.ts pays 60 x streak-multiplier,
          // and the x2 tier at streak >= 7 writes 120 — so EVERY correct answer
          // from a learner on a 7-day streak was denied here and swallowed by
          // the catch in responses.ts. Wrong answers (40) passed, so affected
          // learners' evidence kept their errors and discarded their successes.
          // Confirmed against live data: zero stored documents exceeded 100.
          // New ceiling clears the largest legitimate payout
          // (XP_SIO_BASE + XP_SIO_MASTERY = 600, x2 = 1200) with headroom.
          && request.resource.data.xp <= 2000
          && request.resource.data.timestamp == request.time
          && (!('sessionId' in request.resource.data)
              || (request.resource.data.sessionId is string
                  && request.resource.data.sessionId.size() <= 100))
          && (!('activityId' in request.resource.data)
              || (request.resource.data.activityId is string
                  && request.resource.data.activityId.size() <= 60))
          && (!('latencyMs' in request.resource.data)
              || (request.resource.data.latencyMs is int
                  && request.resource.data.latencyMs >= 0
                  && request.resource.data.latencyMs <= 3600000))
          && (!('givenAnswer' in request.resource.data)
              || (request.resource.data.givenAnswer is string
                  && request.resource.data.givenAnswer.size() <= 200))
          && (!('intervalDays' in request.resource.data)
              || (request.resource.data.intervalDays is number
                  && request.resource.data.intervalDays >= 0
                  && request.resource.data.intervalDays <= 3650))
          && (!('due' in request.resource.data)
              || (request.resource.data.due is int
                  && request.resource.data.due >= 0))
          // ── evidence model ────────────────────────────────────────────
          && (!('outcomeId' in request.resource.data)
              || (request.resource.data.outcomeId is string
                  && request.resource.data.outcomeId.size() <= 40))
          && (!('evidenceType' in request.resource.data)
              || request.resource.data.evidenceType in
                 ['recognition', 'constrained', 'free', 'receptive',
                  'productive', 'transfer', 'delayed', 'diagnostic', 'teacher'])
          && (!('assistance' in request.resource.data)
              || request.resource.data.assistance in
                 ['none', 'nudge', 'question', 'scaffold', 'partial', 'answer'])
          && (!('assistCount' in request.resource.data)
              || (request.resource.data.assistCount is int
                  && request.resource.data.assistCount >= 0
                  && request.resource.data.assistCount <= 20))
          && (!('independent' in request.resource.data)
              || request.resource.data.independent is bool);
        allow update, delete: if false;
      }
      // Session summaries: xp/level only ever rise (a client can't quietly
      // rewrite history), everything bounded so nobody teleports to 2^53.
      match /sessions/{sessionId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && validSession();
        allow update: if isOwner(uid) && validSession()
          && request.resource.data.xp >= resource.data.xp
          && request.resource.data.level >= resource.data.level;
        allow delete: if false;
      }
      // Everything else under the user doc (pretest state/skills/runs, srs,
      // notes, reviser sessions). The sub[0] guard keeps this wildcard from
      // re-granting what the append-only matches above just denied (rules are
      // OR-ed). NOTE: this perimeter means the shape checks above only bind
      // collections the honest client writes — admin analytics must read ONLY
      // the canonical paths (attempts/responses/sessions), never trust
      // sibling collections a client could invent.
      match /{sub=**} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid)
          && !(sub[0] in ['attempts', 'responses', 'sessions']);
      }
    }
    match /leaderboard/{uid} {
      allow read:  if isSignedIn();
      // Admins (teachers) are auto-excluded — they shouldn't appear on the
      // student board (Dan, 2026-07-05) — as are the explicit opt-out emails.
      // VALUE CHECKS on both create and update: this is the most public
      // surface in the app and was previously the only unvalidated write.
      // CREATE gets a strict key allowlist (new rows come only from the
      // current client). UPDATE deliberately does NOT use hasOnly: the app
      // writes with merge:true onto legacy laf1201 rows that still carry
      // totalXP etc., so request.resource.data (the post-merge doc) would
      // fail a strict list — and a denied write makes the client DELETE the
      // user's own row (its excluded-user fallback). Values are what matter.
      allow create: if isOwner(uid) && !isAdmin() && !isExcludedFromLeaderboard()
        && request.resource.data.keys().hasOnly(
            ['name', 'xp', 'level', 'gems', 'streak', 'updatedAt'])
        && validLeaderboardRow();
      allow update: if isOwner(uid) && !isAdmin() && !isExcludedFromLeaderboard()
        && validLeaderboardRow();
      // Owner may ALWAYS delete their own row — so an excluded user's client
      // can clean up a stale entry it wrote before being excluded.
      allow delete: if isOwner(uid);
    }
    // Usage telemetry (usage.ts): shape-checked so evidence-grade analytics
    // can't be polluted with arbitrary documents. Exactly the fields logEvent
    // sends. If a LEGACY site writes events in a different shape, its writes
    // will start failing silently (logEvent swallows errors) — loosen
    // deliberately if legacy telemetry matters.
    match /events/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'payload', 'ts', 'ua', 'site'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.type.size() >= 1
        && request.resource.data.type.size() <= 40
        && request.resource.data.payload is map
        && request.resource.data.payload.size() <= 20
        && request.resource.data.ts == request.time
        && (request.resource.data.ua == null
            || (request.resource.data.ua is string && request.resource.data.ua.size() <= 400))
        && (request.resource.data.site == null
            || (request.resource.data.site is string && request.resource.data.site.size() <= 120));
      allow read: if isAdmin();
    }
    // Written by the LEGACY suite (no writer in this repo) — left unshaped on
    // purpose; shape-checking a writer we can't see would break it blind.
    match /authEvents/{id} { allow create: if isSignedIn(); allow read: if isAdmin(); }
    // Bug reports: anyone may submit (signed in or not); only admins read/triage.
    // Anonymous create is shape-checked so the open write can't be used to park
    // arbitrary documents (spam/abuse): exactly the fields FeedbackButton sends,
    // with size caps matching what the client itself enforces.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['categories', 'details', 'url', 'userAgent', 'uid', 'createdAt', 'screenshot'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 10
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 400
        && (request.resource.data.uid == null
            || (isSignedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time
        && (!('screenshot' in request.resource.data)
            || (request.resource.data.screenshot is string
                && request.resource.data.screenshot.size() <= 300000));
      allow read, update, delete: if isAdmin();
    }
    // Vocabularain hidden language-sorter leaderboard.
    // Anonymous create: open to any visitor (no sign-in required).
    // Shape-checked to prevent abuse: exactly score/name/ts, reasonable bounds.
    match /vlrain_hiscores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['score', 'name', 'ts'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 99999
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
    // USER-CREATED decks (the custom-deck builder). Curated decks are bundled
    // with the app and never touch Firestore — this collection is only what
    // learners author themselves. Update re-applies the create caps (saves
    // send the full document, so the post-merge doc always has title/items)
    // and visibility is whitelisted to the schema's three values.
    match /collections/{id} {
      allow read: if resource.data.visibility in ['public', 'unlisted']
        || (isSignedIn() && resource.data.owner == request.auth.uid)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.owner == request.auth.uid
        && validDeck();
      // Owner may edit but never reassign ownership.
      allow update: if isSignedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && validDeck();
      allow delete: if isSignedIn() && resource.data.owner == request.auth.uid;
    }
    // ── ST2FR26 ORAL TEST (oraltest.withdrchan.com, July 2026) ──────────
    // Booking = one doc per student. Leaders write {size,name,email,ts};
    // size 0 = "open to either" (floater awaiting a match); teammates who
    // confirm an invite add team:<leaderUid>. Signed-in read (the whole
    // class sees the live schedule). Admin may also WRITE: the teacher's
    // "Finalize leftovers" button pairs remaining floaters into duos (the
    // odd one out gets examiner:true) and must preserve each student's
    // original sign-up ts — hence ts == request.time is waived for admin.
    match /oralST2_2026/{uid} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['size', 'name', 'email', 'team', 'ts', 'examiner'])
        && request.resource.data.size in [0, 2, 3]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.ts is timestamp
        && (isAdmin() || request.resource.data.ts == request.time)
        && (!('team' in request.resource.data)
            || (request.resource.data.team is string
                && request.resource.data.team.size() <= 60))
        && (!('examiner' in request.resource.data)
            || request.resource.data.examiner is bool);
      allow delete: if isOwner(uid) || isAdmin();
    }
    // Teammate invites, keyed by the invitee's LOWERCASE Google email.
    // Create: only by the (signed-in) leader, stamped with their own uid.
    // Delete: the leader revokes, the invitee accepts/declines (their token
    // email must match the doc id), or an admin cleans up.
    match /oralST2_2026_invites/{email} {
      allow read: if isSignedIn();
      // Admin may stamp `by` with a pre_ leader key when pre-booking groups
      // on students' behalf from the Teacher tab.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['by', 'byName', 'size', 'ts'])
        && (request.resource.data.by == request.auth.uid || isAdmin())
        && request.resource.data.byName is string
        && request.resource.data.byName.size() >= 1
        && request.resource.data.byName.size() <= 80
        && request.resource.data.size in [2, 3]
        && request.resource.data.ts == request.time;
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.by == request.auth.uid)
        || (isSignedIn() && request.auth.token.email.lower() == email);
    }
    // Outbox for the "Trigger Email from Firestore" extension (invite nudges).
    // Create-only and shape-checked; the extension itself reads/updates via
    // the Admin SDK, which bypasses rules. If the extension isn't installed,
    // docs simply accumulate harmlessly (client treats sending as best-effort).
    match /mail/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 4000;
      allow read, update, delete: if false;
    }
    // SITE-WIDE VISIT ATTENDANCE (shared across every withdrchan.com site on
    // this project — oraltest, laf2201/French 2, and future sites). Doc id is
    // "<site>_<uid>", so the id itself demarcates alongside the `site` field.
    // Owner creates their own first-visit doc, then may only bump
    // lastVisit/visitCount on return visits — every other field is frozen
    // after creation. Admin can read across all students/sites for dashboards
    // and delete for cleanup.
    match /siteVisits/{docId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && docId == request.resource.data.site + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(
            ['site', 'uid', 'email', 'displayName', 'firstVisit', 'lastVisit', 'visitCount'])
        && request.resource.data.site is string
        && request.resource.data.site.size() >= 1
        && request.resource.data.site.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.firstVisit == request.time
        && request.resource.data.lastVisit == request.time
        && request.resource.data.visitCount == 1;
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.site == resource.data.site
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.firstVisit == resource.data.firstVisit
        && request.resource.data.lastVisit == request.time
        && request.resource.data.visitCount == resource.data.visitCount + 1;
      allow delete: if isAdmin();
    }
    // Teacher-only configuration. admin/rosterPrivate holds the roster maps
    // (account aliases, name overrides, uid→email seeds) that used to be
    // compiled into the /teacher page — a public static asset anyone could
    // download. They live here precisely so they are never in the JS the CDN
    // serves. Writer: scripts/seed-roster-private.mjs (service account, which
    // bypasses rules); the isAdmin() write keeps the door open for an
    // in-console edit without a redeploy.
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
    // Explicit default-deny for anything unmatched (self-documenting; Firestore
    // already denies unmatched paths).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
