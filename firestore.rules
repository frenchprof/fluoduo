rules_version = '2';
// Reconciled rules for the unified laf1201 project (hub · pretest · reviser · FluoLingo).
// House style: owner-only writes, admin email allowlist, leaderboard exclusion list.
// Deploy: Firebase console → Firestore → Rules, or `firebase deploy --only firestore:rules`.
//
//   users/{uid}                      profile + reviser XP/progress   (owner read/write, admin read)
//   users/{uid}/attempts/{id}        APPEND-ONLY audit log            (owner create, never edited)
//   users/{uid}/responses/{id}       APPEND-ONLY item-level analytics (owner create, shape-checked)
//   users/{uid}/sessions/{id}        session telemetry                (owner create/update, monotonic)
//   users/{uid}/favourites/{id}      starred pages + folders          (owner write, SHAPE-CHECKED)
//   users/{uid}/{sub=**}             pretest state/skills/runs, srs, notes, reviser sessions
//   leaderboard/{uid}                unified combined-total board     (owner write, VALUE-CHECKED, signed-in read)
//   events / authEvents              telemetry                        (signed-in create; events shape-checked)
//   feedback                         bug reports                      (ANONYMOUS create, shape-checked, admin read)
//   collections/{id}                 user-created decks               (owner write, public/unlisted read)
//   oralST2_2026/{uid}               ST2 oral-test bookings           (owner+admin write, shape-checked, signed-in read)
//   oralST2_2026_invites/{email}     teammate invites by email        (leader create, leader/invitee/admin delete)
//   mail/{id}                        Trigger Email extension outbox   (CLOSED — denies everything)
//   siteVisits/{site}_{uid}          cross-site Google-login attendance (owner create/update, admin read/delete)
//
// ═══ HARDENING PASS, 2026-09-12 ═══════════════════════════════════════════
// Additions only — nothing that was here was removed or loosened.
//
//   1 · mail/{id}          WAS AN OPEN EMAIL RELAY. Any signed-in student
//                          could send any subject/body to any address from
//                          this project's sender. Recipient is now tied to an
//                          invite THIS sender created.        ⚠️ order-dependent
//   2 · oralST2_2026_invites   INVITE SQUATTING: one account could write one
//                          doc per classmate and freeze the booking flow for
//                          everyone (create-only + update:false = first write
//                          wins forever). Creator must now hold a booking, and
//                          may not invite themselves.          ⚠️ order-dependent
//   3 · leaderboard        XP could silently FALL. `sessions` has had a
//                          monotonic guard since it was written; the board,
//                          the most public surface here, did not.
//   4 · collections        DEFENSIVE ONLY — not a bug fix. I predicted a deck
//                          with no `visibility` would make the read rule ERROR
//                          and lock out its own owner. TESTED AGAINST THE
//                          ORIGINAL RULES: it does not — the owner reads it
//                          fine, so Firestore treats the missing field as a
//                          plain false here rather than throwing. The `.get()`
//                          default is kept because it states the intent, but
//                          it changes no behaviour. Recorded so nobody cites
//                          it later as a fault that was found.
//
// ⚠️ THE TWO ORDER-DEPENDENT ONES touch oraltest.withdrchan.com, whose client
//    is not in this repo. Deploy those only after checking that client writes
//    the invite (and the leader's own booking) BEFORE it queues the mail. Each
//    carries a one-line fallback in its own comment if it does not.
//
// STILL OPEN, and NOT fixable in rules — do not read this file as "done":
//
//   · LEADERBOARD XP IS SELF-REPORTED. A learner can publish xp: 10000000 and
//     top the board; validLeaderboardRow()'s cap is the only ceiling a rule
//     can impose, because the client is the source of truth. The real fix is a
//     Cloud Function totalling users/{uid}/responses server-side.
//   · ANONYMOUS WRITES HAVE NO VOLUME LIMIT. feedback/{id} takes a 300 KB
//     screenshot with no sign-in at all, and vlrain_hiscores/{id} is open too.
//     Both are deliberate and both are a billing/storage tap anyone can open.
//     Rules cannot rate-limit. The answer is App Check — see the block below.
//   · authEvents/{id} IS UNSHAPED by design (its writer is in the legacy suite
//     and cannot be seen from here), so any signed-in account can store
//     arbitrary documents there. Left alone on purpose; tightening it blind is
//     how a silent telemetry break starts.
// ══════════════════════════════════════════════════════════════════════════
//
// ═══ 2026-09-13 · THIS FILE HAD DRIFTED FROM WHAT IS LIVE ═════════════════
// Two changes, and they had been sitting on OPPOSITE sides of the console.
//
//   mail/{id}    LIVE was ahead. Dan closed the letterbox in the console on
//                12 Sep (*"i am never going to be using this to do oral exam
//                ever again"*) and the closure never came back into git, so
//                this file still carried the weaker "tied to an invite"
//                create rule. Anyone deploying the repo copy would have
//                RE-OPENED it. Now merged in.
//   level >= 1   GIT was ahead, and only because of the fix below — it is
//                still `>= 1` in the console until the file is pasted in.
//
// SO THE RULE, PLAINLY: this file is not the source of truth and cannot be.
// Nothing here deploys itself — the console does, by hand. Before changing
// it, ask Dan for the live copy and diff, or a correct-looking edit will
// silently roll a live fix backwards. `verify580-rule-bounds.py` says the
// same thing in its own docstring and cannot close the gap either.
// ══════════════════════════════════════════════════════════════════════════
//
// APP CHECK — the only real defence for the two anonymous-write collections.
// LESS REMAINS TO BE DONE THAN THIS NOTE FIRST CLAIMED: the SDK side ALREADY
// SHIPS. src/lib/firebase/client.ts initialises App Check whenever
// NEXT_PUBLIC_FIREBASE_APPCHECK_KEY is set at build time (reCAPTCHA v3, or
// Enterprise when NEXT_PUBLIC_FIREBASE_APPCHECK_PROVIDER=enterprise). So the
// outstanding work is the KEY and the CONSOLE, not the client.
//
// That file also records why enforcement is deliberately off: "keep Firestore
// enforcement OFF in the Firebase console until App Check metrics show ~100%
// verified traffic (the legacy laf1201 sites share this project and must be
// attested too before enforcing)". The same reason applies to the rule below —
// turning it on first would deny every write from an unattested legacy site.
//
// So: set the key at build time, watch the console's unverified-requests
// metric fall to zero across ALL the laf1201 sites, THEN uncomment the
// function and add `&& appChecked()` to the create rules on feedback/{id} and
// vlrain_hiscores/{id}.
//
//   function appChecked() { return request.app != null; }
//
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // email_verified guard: Google sign-in always verifies, but if another
    // auth provider is ever enabled, an attacker could otherwise mint an
    // UNVERIFIED token bearing an admin email and pass the allowlist.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in [
        "drneilchan@gmail.com", "monsieur.chan@gmail.com", "dan@chank.wang",
        "kaygeedan@gmail.com", "daniel.chan@nus.edu.sg", "kwangguan@gmail.com"
      ];
    }
    function isExcludedFromLeaderboard() {
      return isSignedIn() && request.auth.token.email in [
        "wanghaoshu2016@gmail.com", "theneonwolf0404@gmail.com", "clariseloke13@gmail.com",
        "nusally2023@gmail.com", "adrihashim@gmail.com", "enileg864@gmail.com",
        "mielanjames@gmail.com", "chee.advanced@gmail.com", "lohkelsey@gmail.com",
        "adamelistewart@gmail.com", "danielbordeaux89@gmail.com", "e1088156@u.nus.edu",
        "2964836865@qq.com", "wyanfong@gmail.com", "tcyy.10204@gmail.com",
        "azhari619@gmail.com", "clariceteoworking@gmail.com",
        // Dan's alter-ego test learners (2026-09-13). Here and not in
        // isAdmin(): they must stay off the board, but they get no admin read
        // of anyone else's data. Mirrored by TEST_ACCOUNT_EMAILS in
        // src/lib/staffAccounts.ts — the client refuses the write too, because
        // this file is deployed by hand and that one ships with every build.
        "docteur.daniel.chan@gmail.com", "u12@i12.work"
      ];
    }
    function validLeaderboardRow() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 10000000
        && request.resource.data.level is int
        // LEVEL 0 IS A REAL LEVEL, AND `>= 1` KEPT EVERY BEGINNER OFF THE
        // BOARD (2026-09-13). `levelForXp` in src/lib/economy.ts starts at 0
        // and LEVEL_SPANS[0] is 2000, so a learner is level 0 until 2000 XP —
        // which is every new learner, and the whole cohort at the start of a
        // term. Their row was DENIED, and the client reads a denied write as
        // "this account is a teacher or has opted out" and DELETES the row it
        // just tried to write. So the board did not merely miss them: it
        // erased them, silently, and read « Nobody yet — be the first 💎! ».
        //
        // Dan proved it by signing in on a non-admin account, earning XP and
        // watching nothing appear. The rule, not the policy, was the reason.
        && request.resource.data.level >= 0
        && request.resource.data.level <= 1000
        && request.resource.data.gems is int
        && request.resource.data.gems >= 0
        && request.resource.data.gems <= 1000000
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 100000
        // Weekly race (2026-08-21): optional for the same reason as `term` —
        // a legacy laf1201 row updated with merge:true has neither field, and
        // a denied write makes the client delete the learner's own row. When
        // present, weekXp is bounded like xp and weekKey is a short key.
        && (!('weekXp' in request.resource.data)
            || (request.resource.data.weekXp is int
                && request.resource.data.weekXp >= 0
                && request.resource.data.weekXp <= 10000000))
        && (!('weekKey' in request.resource.data)
            || request.resource.data.weekKey == null
            || (request.resource.data.weekKey is string
                && request.resource.data.weekKey.size() <= 10))
        // Cohort marker (2026-08-11 reset): optional so legacy merge:true
        // updates keep passing; when present it must be a short string.
        && (!('term' in request.resource.data)
            || (request.resource.data.term is string
                && request.resource.data.term.size() <= 20));
    }
    function validSession() {
      return request.resource.data.keys().hasOnly(
          ['xp', 'level', 'streak', 'lastStreakDate', 'itemPointer',
           'startedAt', 'updatedAt', 'durationMs', 'activityId'])
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 10000000
        && request.resource.data.level is int
        // THE SAME `>= 1`, AND THE SAME REASON IT IS WRONG — see the
        // leaderboard block above. PRECAUTIONARY, NOT PROVEN: this collection's
        // writer is in the legacy laf1201 suite and cannot be seen from this
        // repo, so whether it publishes a level at all is unknown here.
        // Loosening a lower bound can only ever ALLOW a write that was denied,
        // never deny one that passed, which is why it is safe to make without
        // sight of the writer — unlike tightening, which this file warns
        // against doing blind.
        && request.resource.data.level >= 0
        && request.resource.data.level <= 1000
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 100000
        && (!('durationMs' in request.resource.data)
            || (request.resource.data.durationMs is int
                && request.resource.data.durationMs >= 0
                && request.resource.data.durationMs <= 86400000))
        && (!('activityId' in request.resource.data)
            || (request.resource.data.activityId is string
                && request.resource.data.activityId.size() <= 60));
    }
    // FAVOURITES (2026-09-12). Dan: "allow learners to favourite particular
    // pages or activity so they can revisit ... it should even allow them to
    // organise into folders". One document holds the whole list — a folder
    // move and a rename both touch two rows at once, and a single document is
    // one read, one write and no query.
    //
    // WHAT RULES CAN AND CANNOT CHECK, said plainly: there are no loops in
    // this language, so the SIZE and TYPE of the two lists are enforceable and
    // the shape of each row inside them is not. The caps are therefore the
    // real protection — they stop the document being used as free storage —
    // and the row shape is enforced by the client (`coerce` in
    // lib/favourites.ts drops anything malformed on read, so a poisoned
    // document degrades to an empty list rather than a broken page).
    function validFavourites() {
      return request.resource.data.keys().hasOnly(['v', 'items', 'folders', 'updatedAt'])
        && request.resource.data.v is int
        && request.resource.data.v >= 1
        && request.resource.data.v <= 100
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && request.resource.data.folders is list
        && request.resource.data.folders.size() <= 20
        && (!('updatedAt' in request.resource.data)
            || (request.resource.data.updatedAt is int
                && request.resource.data.updatedAt >= 0));
    }
    function validDeck() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 500
        && (!('visibility' in request.resource.data)
            || request.resource.data.visibility in ['public', 'unlisted', 'private']);
    }
    match /users/{uid} {
      // Owner + admin only. The old "signed-in read" existed for a leaderboard
      // that now lives in its own collection; leaving it open let any student
      // enumerate every other student's profile. If a LEGACY site (hub /
      // pretest / reviser) still lists /users cross-user, it will start
      // getting permission-denied — loosen back deliberately if that happens.
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
      // Append-only audit log: attempt records can be created and read, never
      // edited or deleted — a trustworthy history even against the owner.
      match /attempts/{attemptId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
      // Item-level learning analytics, APPEND-ONLY and shape-checked. Field
      // names align with the SRS store (srs.ts): intervalDays + due, so the
      // response log and the scheduler speak the same language. latencyMs and
      // givenAnswer are optional analytics fields (fluency curves / error
      // taxonomy) — validated when present so they can ship later without a
      // rules redeploy.
     match /responses/{responseId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
              ['item', 'attempts', 'status', 'xp', 'timestamp', 'sessionId', 'activityId',
               'latencyMs', 'givenAnswer', 'intervalDays', 'due',
               // Evidence model (2026-08-10). All optional, so existing writers
               // keep working unchanged. PRD §7: a correct answer is not one
               // fact — it matters HOW it was produced.
               'outcomeId', 'evidenceType', 'assistance', 'assistCount', 'independent'])
          && request.resource.data.item is string
          && request.resource.data.item.size() >= 1
          && request.resource.data.item.size() <= 200
          && request.resource.data.attempts is list
          && request.resource.data.attempts.size() >= 1
          && request.resource.data.attempts.size() <= 20
          && request.resource.data.status in ['met', 'missed', 'retried', 'mastered']
          && request.resource.data.xp is int
          && request.resource.data.xp >= 0
          // WAS 100 (fixed 2026-08-10). progress.ts pays 60 x streak-multiplier,
          // and the x2 tier at streak >= 7 writes 120 — so EVERY correct answer
          // from a learner on a 7-day streak was denied here and swallowed by
          // the catch in responses.ts. Wrong answers (40) passed, so affected
          // learners' evidence kept their errors and discarded their successes.
          // Confirmed against live data: zero stored documents exceeded 100.
          // New ceiling clears the largest legitimate payout
          // (XP_SIO_BASE + XP_SIO_MASTERY = 600, x2 = 1200) with headroom.
          && request.resource.data.xp <= 2000
          && request.resource.data.timestamp == request.time
          && (!('sessionId' in request.resource.data)
              || (request.resource.data.sessionId is string
                  && request.resource.data.sessionId.size() <= 100))
          && (!('activityId' in request.resource.data)
              || (request.resource.data.activityId is string
                  && request.resource.data.activityId.size() <= 60))
          && (!('latencyMs' in request.resource.data)
              || (request.resource.data.latencyMs is int
                  && request.resource.data.latencyMs >= 0
                  && request.resource.data.latencyMs <= 3600000))
          && (!('givenAnswer' in request.resource.data)
              || (request.resource.data.givenAnswer is string
                  && request.resource.data.givenAnswer.size() <= 200))
          && (!('intervalDays' in request.resource.data)
              || (request.resource.data.intervalDays is number
                  && request.resource.data.intervalDays >= 0
                  && request.resource.data.intervalDays <= 3650))
          && (!('due' in request.resource.data)
              || (request.resource.data.due is int
                  && request.resource.data.due >= 0))
          // ── evidence model ────────────────────────────────────────────
          && (!('outcomeId' in request.resource.data)
              || (request.resource.data.outcomeId is string
                  && request.resource.data.outcomeId.size() <= 40))
          && (!('evidenceType' in request.resource.data)
              || request.resource.data.evidenceType in
                 ['recognition', 'constrained', 'free', 'receptive',
                  'productive', 'transfer', 'delayed', 'diagnostic', 'teacher'])
          && (!('assistance' in request.resource.data)
              || request.resource.data.assistance in
                 ['none', 'nudge', 'question', 'scaffold', 'partial', 'answer'])
          && (!('assistCount' in request.resource.data)
              || (request.resource.data.assistCount is int
                  && request.resource.data.assistCount >= 0
                  && request.resource.data.assistCount <= 20))
          && (!('independent' in request.resource.data)
              || request.resource.data.independent is bool);
        allow update, delete: if false;
      }
      // Session summaries: xp/level only ever rise (a client can't quietly
      // rewrite history), everything bounded so nobody teleports to 2^53.
      match /sessions/{sessionId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && validSession();
        allow update: if isOwner(uid) && validSession()
          && request.resource.data.xp >= resource.data.xp
          && request.resource.data.level >= resource.data.level;
        allow delete: if false;
      }
      // Starred pages and their folders. THIS MATCH ONLY BITES BECAUSE
      // 'favourites' IS EXCLUDED FROM THE WILDCARD BELOW — rules are OR-ed,
      // so a shaped rule sitting beside a permissive `{sub=**}` is decorative:
      // the wildcard would allow the write this block refuses. Adding a path
      // here means adding it to that list in the same edit, or the caps are a
      // comment rather than a rule.
      match /favourites/{favDocId} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) && validFavourites();
      }
      // Everything else under the user doc (pretest state/skills/runs, srs,
      // notes, reviser sessions). The sub[0] guard keeps this wildcard from
      // re-granting what the append-only matches above just denied (rules are
      // OR-ed). NOTE: this perimeter means the shape checks above only bind
      // collections the honest client writes — admin analytics must read ONLY
      // the canonical paths (attempts/responses/sessions), never trust
      // sibling collections a client could invent.
      match /{sub=**} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid)
          && !(sub[0] in ['attempts', 'responses', 'sessions', 'favourites']);
      }
    }
    match /leaderboard/{uid} {
      allow read:  if isSignedIn();
      // Admins (teachers) are auto-excluded — they shouldn't appear on the
      // student board (Dan, 2026-07-05) — as are the explicit opt-out emails.
      // VALUE CHECKS on both create and update: this is the most public
      // surface in the app and was previously the only unvalidated write.
      // CREATE gets a strict key allowlist (new rows come only from the
      // current client). UPDATE deliberately does NOT use hasOnly: the app
      // writes with merge:true onto legacy laf1201 rows that still carry
      // totalXP etc., so request.resource.data (the post-merge doc) would
      // fail a strict list — and a denied write makes the client DELETE the
      // user's own row (its excluded-user fallback). Values are what matter.
      allow create: if isOwner(uid) && !isAdmin() && !isExcludedFromLeaderboard()
        && request.resource.data.keys().hasOnly(
            ['name', 'xp', 'level', 'gems', 'streak', 'weekXp', 'weekKey', 'term', 'updatedAt'])
        && validLeaderboardRow();
      // ADDED 2026-09-12: XP MAY NOT FALL, except across a cohort reset.
      // `sessions` has had this guard since it was written ("a client can't
      // quietly rewrite history"); the board — the most public surface in the
      // app — did not, so a stale or tampered client could publish a LOWER
      // lifetime figure over a higher one. `.get(...)` with defaults because a
      // legacy laf1201 row has neither `xp` nor `term`, and a bare read of a
      // missing field is an error that denies.
      //
      // WHAT THIS DOES NOT DO, said plainly so nobody reads it as more than it
      // is: it does not stop a learner setting xp to 10,000,000 in one write.
      // The client is the source of truth for XP, so the cap in
      // validLeaderboardRow() is the only ceiling rules can impose. Making the
      // board tamper-proof needs the total computed server-side (a Cloud
      // Function over users/{uid}/responses), not a stricter rule.
      allow update: if isOwner(uid) && !isAdmin() && !isExcludedFromLeaderboard()
        && validLeaderboardRow()
        && (request.resource.data.xp >= resource.data.get('xp', 0)
            || request.resource.data.get('term', '') != resource.data.get('term', ''));
      // Owner may ALWAYS delete their own row — so an excluded user's client
      // can clean up a stale entry it wrote before being excluded.
      allow delete: if isOwner(uid);
    }
    // Usage telemetry (usage.ts): shape-checked so evidence-grade analytics
    // can't be polluted with arbitrary documents. Exactly the fields logEvent
    // sends. If a LEGACY site writes events in a different shape, its writes
    // will start failing silently (logEvent swallows errors) — loosen
    // deliberately if legacy telemetry matters.
    match /events/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'payload', 'ts', 'ua', 'site'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.type.size() >= 1
        && request.resource.data.type.size() <= 40
        && request.resource.data.payload is map
        && request.resource.data.payload.size() <= 20
        && request.resource.data.ts == request.time
        && (request.resource.data.ua == null
            || (request.resource.data.ua is string && request.resource.data.ua.size() <= 400))
        && (request.resource.data.site == null
            || (request.resource.data.site is string && request.resource.data.site.size() <= 120));
      allow read: if isAdmin();
    }
    // Written by the LEGACY suite (no writer in this repo) — left unshaped on
    // purpose; shape-checking a writer we can't see would break it blind.
    match /authEvents/{id} { allow create: if isSignedIn(); allow read: if isAdmin(); }
    // Bug reports: anyone may submit (signed in or not); only admins read/triage.
    // Anonymous create is shape-checked so the open write can't be used to park
    // arbitrary documents (spam/abuse): exactly the fields FeedbackButton sends,
    // with size caps matching what the client itself enforces.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['categories', 'details', 'url', 'userAgent', 'uid', 'createdAt', 'screenshot'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 10
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 400
        && (request.resource.data.uid == null
            || (isSignedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time
        && (!('screenshot' in request.resource.data)
            || (request.resource.data.screenshot is string
                && request.resource.data.screenshot.size() <= 300000));
      allow read, update, delete: if isAdmin();
    }
    // Vocabularain hidden language-sorter leaderboard.
    // Anonymous create: open to any visitor (no sign-in required).
    // Shape-checked to prevent abuse: exactly score/name/ts, reasonable bounds.
    match /vlrain_hiscores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['score', 'name', 'ts'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 99999
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
    // USER-CREATED decks (the custom-deck builder). Curated decks are bundled
    // with the app and never touch Firestore — this collection is only what
    // learners author themselves. Update re-applies the create caps (saves
    // send the full document, so the post-merge doc always has title/items)
    // and visibility is whitelisted to the schema's three values.
    match /collections/{id} {
      // ADDED 2026-09-12, DEFENSIVE ONLY — this fixes nothing that was broken.
      // The prediction was that a deck written WITHOUT `visibility` (validDeck
      // makes it optional) would make the bare read an undefined-field ERROR
      // and deny the whole `||`, locking the OWNER out of their own deck.
      // MEASURED against the original rules with a seeded deck that has no
      // `visibility`: the owner reads it fine. The `.get('visibility',
      // 'private')` form is kept only because it says out loud what the rule
      // means; behaviour is unchanged. Do not cite this as a bug that was.
      allow read: if resource.data.get('visibility', 'private') in ['public', 'unlisted']
        || (isSignedIn() && resource.data.owner == request.auth.uid)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.owner == request.auth.uid
        && validDeck();
      // Owner may edit but never reassign ownership.
      allow update: if isSignedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && validDeck();
      allow delete: if isSignedIn() && resource.data.owner == request.auth.uid;
    }
    // ── ST2FR26 ORAL TEST (oraltest.withdrchan.com, July 2026) ──────────
    // Booking = one doc per student. Leaders write {size,name,email,ts};
    // size 0 = "open to either" (floater awaiting a match); teammates who
    // confirm an invite add team:<leaderUid>. Signed-in read (the whole
    // class sees the live schedule). Admin may also WRITE: the teacher's
    // "Finalize leftovers" button pairs remaining floaters into duos (the
    // odd one out gets examiner:true) and must preserve each student's
    // original sign-up ts — hence ts == request.time is waived for admin.
    match /oralST2_2026/{uid} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['size', 'name', 'email', 'team', 'ts', 'examiner'])
        && request.resource.data.size in [0, 2, 3]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.ts is timestamp
        && (isAdmin() || request.resource.data.ts == request.time)
        && (!('team' in request.resource.data)
            || (request.resource.data.team is string
                && request.resource.data.team.size() <= 60))
        && (!('examiner' in request.resource.data)
            || request.resource.data.examiner is bool);
      allow delete: if isOwner(uid) || isAdmin();
    }
    // Teammate invites, keyed by the invitee's LOWERCASE Google email.
    // Create: only by the (signed-in) leader, stamped with their own uid.
    // Delete: the leader revokes, the invitee accepts/declines (their token
    // email must match the doc id), or an admin cleans up.
    match /oralST2_2026_invites/{email} {
      allow read: if isSignedIn();
      // Admin may stamp `by` with a pre_ leader key when pre-booking groups
      // on students' behalf from the Teacher tab.
      // ADDED 2026-09-12 — INVITE SQUATTING. Any signed-in student could
      // create the doc at any classmate's address, and because `update` is
      // false and `create` only fires on a MISSING doc, the real leader was
      // then permanently unable to invite that person: one malicious account
      // could write one doc per classmate and freeze the whole booking flow.
      // (`byName` is free text too, so the squatted row could read "Dr Chan".)
      //
      // Two additions, both cheap: the creator must actually HOLD a booking —
      // so an invite is attributable to a real sign-up rather than to any
      // account that can reach Firestore — and nobody may invite themselves.
      //
      // ⚠️ ORDER-DEPENDENT — same caveat as /mail below: this assumes the
      // oraltest client writes the leader's own oralST2_2026/<uid> booking
      // BEFORE it sends invites. Not verifiable from this repo.
      allow create: if isSignedIn()
        && (isAdmin() || exists(/databases/$(database)/documents/oralST2_2026/$(request.auth.uid)))
        && (isAdmin() || request.auth.token.email.lower() != email)
        && request.resource.data.keys().hasOnly(['by', 'byName', 'size', 'ts'])
        && (request.resource.data.by == request.auth.uid || isAdmin())
        && request.resource.data.byName is string
        && request.resource.data.byName.size() >= 1
        && request.resource.data.byName.size() <= 80
        && request.resource.data.size in [2, 3]
        && request.resource.data.ts == request.time;
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.by == request.auth.uid)
        || (isSignedIn() && request.auth.token.email.lower() == email);
    }
    // Outbox for the "Trigger Email from Firestore" extension (invite nudges).
    // Create-only and shape-checked; the extension itself reads/updates via
    // the Admin SDK, which bypasses rules. If the extension isn't installed,
    // docs simply accumulate harmlessly (client treats sending as best-effort).
    //
    // ADDED 2026-09-12 — THIS WAS AN OPEN EMAIL RELAY. `isSignedIn()` plus a
    // shape check let ANY signed-in student post a document the Trigger Email
    // extension then SENDS, to any address on earth, with a subject and body
    // they choose, from this project's configured sender. Concretely, this
    // document was accepted from any student account:
    //
    //     to:      ["victim@anywhere.com"]
    //     message: { subject: "Your NUS result", text: "<anything>" }
    //
    // Shape-checking never touched the two things that matter — WHO receives
    // it and WHO sent it — so the school's sender reputation was available to
    // the whole class. The fix ties the recipient to the sender's OWN invite:
    // an address may only be mailed if an invite doc exists at that address
    // AND this sender created it. That is exactly the "invite nudge" the
    // outbox was built for, and nothing else.
    //
    // ⚠️ ORDER-DEPENDENT — VERIFY BEFORE DEPLOYING. This assumes the oraltest
    // client writes oralST2_2026_invites/<email> BEFORE the mail doc. That
    // client is not in this repo, so it could not be checked from here. If it
    // mails first, the nudge will start failing: either flip the two writes in
    // the client, or drop the `.data.by ==` line and keep only `exists(...)`,
    // which still blocks arbitrary recipients.
    match /mail/{id} {
      // CLOSED (Dan, 2026-09-12: *"i am never going to be using this to do
      // oral exam ever again"*). This box existed for ONE feature — the
      // oral-test teammate invitation email — and that feature is retired.
      //
      // A letterbox with no legitimate sender is still a letterbox anyone can
      // post through: the Trigger Email extension SENDS whatever lands here,
      // from the project's own sending account, so any signed-in student
      // could mail any address with any subject and body. Shaping the letter
      // (the old rule) never checked who it was going to or who sent it.
      //
      // Nothing writes here any more — verified by reading the shipped code of
      // every site on this project: oraltest has the only writer, fluoduo and
      // laf2201 have none. So this denies everything rather than trying to
      // tell a good letter from a bad one.
      //
      // BELT AND BRACES: also remove the Trigger Email extension in the
      // Firebase console. A rule stops the writing; removing the extension
      // stops the sending, and the two failures are independent.
      allow read, create, update, delete: if false;
    }
    // SITE-WIDE VISIT ATTENDANCE (shared across every withdrchan.com site on
    // this project — oraltest, laf2201/French 2, and future sites). Doc id is
    // "<site>_<uid>", so the id itself demarcates alongside the `site` field.
    // Owner creates their own first-visit doc, then may only bump
    // lastVisit/visitCount on return visits — every other field is frozen
    // after creation. Admin can read across all students/sites for dashboards
    // and delete for cleanup.
    match /siteVisits/{docId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && docId == request.resource.data.site + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(
            ['site', 'uid', 'email', 'displayName', 'firstVisit', 'lastVisit', 'visitCount'])
        && request.resource.data.site is string
        && request.resource.data.site.size() >= 1
        && request.resource.data.site.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.firstVisit == request.time
        && request.resource.data.lastVisit == request.time
        && request.resource.data.visitCount == 1;
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.site == resource.data.site
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.firstVisit == resource.data.firstVisit
        && request.resource.data.lastVisit == request.time
        && request.resource.data.visitCount == resource.data.visitCount + 1;
      allow delete: if isAdmin();
    }
   // Teacher-only configuration. admin/rosterPrivate holds the roster maps
    // (account aliases, name overrides, uid→email seeds) that used to be
    // compiled into the /teacher page — a public static asset anyone could
    // download. They live here precisely so they are never in the JS the CDN
    // serves. Writer: scripts/seed-roster-private.mjs (service account, which
    // bypasses rules); the isAdmin() write keeps the door open for an
    // in-console edit without a redeploy.
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
    // Explicit default-deny for anything unmatched (self-documenting; Firestore
    // already denies unmatched paths).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
