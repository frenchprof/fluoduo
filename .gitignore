# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
patch*/

# Python bytecode
__pycache__/
*.py[cod]

# Seeded design-canvas outputs — regenerate with seed-canvas.mjs from the
# .dc.html artboards + canvas.json, which are the source of truth.
work/*/fluolingo-*-mockups.html
# Screenshot output from the work/ harnesses — regenerate, never commit
# (work/patch*/ is already covered by the patch*/ rule above)
work/**/*.png

# Patch backups — `patch` and `git apply` drop a .orig next to every file they
# touch, and a .rej for every hunk that fails. Two .orig files rode into
# 053c1c9 that way and sat in src/ until 25 Aug. They are never source.
*.orig
*.rej

# merge-handoff-csv.py keeps the previous handoff CSV beside the new one
*.csv.bak

# Agent worktrees (session-local working copies; auto-cleaned)
.claude/worktrees/

# Scratch from verify112-vs-last-week.py — it builds a throwaway tsconfig
# here while it runs. Committed by accident on 2026-09-09 by a `git add -A`
# that ran while a sweep was mid-flight; ignored so it cannot happen again.
.tmp-verify-vslastweek/

# Scratch from verify109-lucky-find.py, which transpiles src/lib and
# src/content here to run them. Same hazard as the line above, found the
# same way: a full verify sweep leaves 26 untracked .js files behind, and
# the next `git add -A` sweeps them in. Ignored before that happens.
.tmp-verify-find/

# Scratch from verify114-level-curve.py. THE THIRD OF THESE, and the reason
# it is worth a line rather than a `rm`: a full verify sweep leaves it behind,
# and this repo has already committed such a directory once by accident (see
# the 9 Sep note above). It was caught here by a stop hook reporting untracked
# files, which is the same near-miss a third time — so it is ignored before a
# `git add -A` sweeps it in, not after.
.tmp-verify-levels/

# Firebase emulator logs, written into the repo root by `firebase emulators:*`
# whenever the rules suite runs (scripts/rules-test/run.mjs). Same hazard as
# the two verify scratch directories above: a `git add -A` after a rules run
# would sweep them in.
firestore-debug.log
firebase-debug.log
ui-debug.log
