# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
patch*/

# Python bytecode
__pycache__/
*.py[cod]

# Seeded design-canvas outputs — regenerate with seed-canvas.mjs from the
# .dc.html artboards + canvas.json, which are the source of truth.
work/*/fluolingo-*-mockups.html
# Screenshot output from the work/ harnesses — regenerate, never commit
# (work/patch*/ is already covered by the patch*/ rule above)
work/**/*.png

# Patch backups — `patch` and `git apply` drop a .orig next to every file they
# touch, and a .rej for every hunk that fails. Two .orig files rode into
# 053c1c9 that way and sat in src/ until 25 Aug. They are never source.
*.orig
*.rej

# merge-handoff-csv.py keeps the previous handoff CSV beside the new one
*.csv.bak

# Agent worktrees (session-local working copies; auto-cleaned)
.claude/worktrees/

# Scratch from verify112-vs-last-week.py — it builds a throwaway tsconfig
# here while it runs. Committed by accident on 2026-09-09 by a `git add -A`
# that ran while a sweep was mid-flight; ignored so it cannot happen again.
.tmp-verify-vslastweek/
